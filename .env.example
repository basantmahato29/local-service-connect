# ==============================================================================
# Local Service Connect - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit the .env file containing real secrets to version control.

# Application Profile
# Options: 'local' (H2 persistent database) or 'mysql' (Production MySQL)
SPRING_PROFILES_ACTIVE=local
PORT=8080

# JWT Security Configuration
# CRITICAL: Replace with a long cryptographically secure random string (at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# Default System Administrator Account
# Seeded automatically on initial clean startup if not present
ADMIN_EMAIL=admin@localserviceconnect.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Production MySQL Database Connection (used when SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/local_service_connect?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USER=lsc_app_user
DB_PASSWORD=replace_with_secure_db_password

# Demo Data Seeding
# Set to 'false' for production deployments
SEED_DEMO_DATA=false

# Google Maps Platform Integration (Optional)
# If left blank, application operates in manual address mode with standard geocoding fallbacks
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
MAPS_DEFAULT_LAT=23.3441
MAPS_DEFAULT_LNG=85.3096
MAPS_DEFAULT_ZOOM=12

# SMS Gateway Configuration (Optional - 'none', 'twilio', or 'msg91')
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=LSCSRV

# Quick Service Operational Thresholds
APP_QS_TARGET_MINUTES=10
APP_QS_UNASSIGNED_THRESHOLD_MINUTES=5
APP_QS_ARRIVAL_DELAY_THRESHOLD_MINUTES=20
APP_QS_ALERT_COOLDOWN_MINUTES=30
